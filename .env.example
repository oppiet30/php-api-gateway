# Copy to .env and replace placeholders. Never commit .env.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=php_api_gateway
DB_USER=php_api_gateway
DB_PASSWORD=CHANGE_ME

# Required after merging JWT PR #2:
JWT_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_BYTES
JWT_ISSUER=php-api-gateway
JWT_AUDIENCE=php-api-gateway-clients
